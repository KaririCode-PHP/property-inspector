{
    "name": "kariricode/property-inspector",
    "description": "Attribute-based property analysis and inspection for the KaririCode Framework, enabling dynamic validation, normalization, and processing of object properties via PHP 8.4+ attributes and reflection.",
    "keywords": [
        "kariri-code",
        "property-inspector",
        "attribute",
        "reflection",
        "validation",
        "normalization",
        "inspection",
        "object-properties",
        "dynamic-analysis",
        "metadata",
        "framework",
        "php84"
    ],
    "homepage": "https://kariricode.org",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Walmir Silva",
            "email": "community@kariricode.org"
        }
    ],
    "require": {
        "php": "^8.4",
        "kariricode/contract": "^2.8",
        "kariricode/exception": "^1.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "infection/infection": "^0.29",
        "nikic/php-parser": "^5.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "vimeo/psalm": "^6.10"
    },
    "autoload": {
        "psr-4": {
            "KaririCode\\PropertyInspector\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KaririCode\\PropertyInspector\\Tests\\": "tests"
        },
        "exclude-from-classmap": [
            "tests/Fixture/"
        ]
    },
    "scripts": {
        "test": "phpunit --testsuite=Unit,Integration",
        "test-conformance": "phpunit --testsuite=Conformance",
        "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
        "psalm": "psalm --no-cache --no-progress --show-info=false",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "complexity": "@php tools/complexity.php src",
        "secret-scan": "@php tools/secret-scan.php",
        "sbom": "@php tools/sbom.php",
        "infection": "infection --threads=max --no-progress --show-mutations",
        "security": [
            "@composer validate --strict",
            "@composer audit --locked",
            "@secret-scan",
            "phpunit --group=fail-closed"
        ],
        "quality": [
            "@cs-check",
            "@phpstan",
            "@psalm",
            "@complexity",
            "@test",
            "@test-conformance",
            "@security"
        ]
    },
    "scripts-descriptions": {
        "quality": "Spec V4.3.3 §29.1 gate: style, static analysis, complexity, tests, conformance, security",
        "infection": "Mutation testing (MSI >= 80%, needs pcov or Xdebug)",
        "sbom": "CycloneDX 1.5 SBOM from composer.lock into build/"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "infection/extension-installer": false
        }
    },
    "extra": {
        "kariricode": {
            "arfa": {
                "version": "1.3",
                "level": 1
            },
            "asvs": {
                "version": "5.0",
                "level": 1
            },
            "spec": "4.3.3",
            "error-code-range": "PI-2500–2599"
        }
    },
    "support": {
        "issues": "https://github.com/KaririCode-Framework/kariricode-property-inspector/issues",
        "source": "https://github.com/KaririCode-Framework/kariricode-property-inspector"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
